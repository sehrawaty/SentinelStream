# SentinelStream: example configuration. Contains no real secrets.
# Every value below is optional: the API falls back to these local defaults
# (api/src/main/resources/application.yml) when a variable is not set.
# To override one, set it as an environment variable before starting the API.

REDIS_URL=redis://localhost:6379
MONGO_URI=mongodb://localhost:27017/sentinel?replicaSet=rs0&directConnection=true&w=majority
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
# Must match the initial password set on the local Neo4j instance.
NEO4J_PASSWORD=change-me
CONSUMER_NAME=consumer-1
